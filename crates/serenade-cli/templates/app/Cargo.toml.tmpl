[package]
name = "__PACKAGE_NAME__"
version = "1.0.0"
edition = "2024"
publish = false

[[bin]]
name = "__PACKAGE_NAME__"
path = "src/main.rs"

[dependencies]
serenade-bundle = "1.0.0"
serenade-config = "1.0.0"
serenade-console = "1.0.0"
serenade-di = "1.0.0"
serenade-event = "1.0.0"
